# Directory containing the input data files (parquet/CSV).
# See README.md for the expected subdirectory structure.
DATA_DIR=/path/to/your/data

# Directory where training run outputs (W&B logs, predictions) are saved.
RUN_DIR=/path/to/your/training-runs

# Directory where PyTorch Lightning trainer logs are stored.
LOG_DIR=/path/to/your/logs

# Path to this repository root.
PROJECT=/path/to/vcc

# Directory where final results are saved.
RESULT_DIR=/path/to/your/results
